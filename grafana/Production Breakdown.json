      },
      "pluginVersion": "12.3.0",
      "targets": [
        {
          "dataset": "iox",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  CASE\n    WHEN $__interval_ms >= 2592000000\n      THEN DATE_TRUNC('month', time)\n    ELSE\n      DATE_TRUNC('day', time)\n  END AS period,\n\n  -- Energy components\n  SUM(feed_in) AS feed_in,\n  SUM(house_from_grid) AS house_from_grid,\n  SUM(house_from_pv) AS house_from_pv,\n\n  -- Derived totals\n  SUM(house_from_pv + feed_in) AS pv_energy,\n  SUM(house_from_pv + house_from_grid) AS house_total,\n\n  -- KPIs\n  100 * SUM(house_from_pv)\n      / NULLIF(SUM(house_from_pv + feed_in), 0)\n      AS self_consumption_pct,\n\n  100 * SUM(house_from_pv)\n      / NULLIF(SUM(house_from_pv + house_from_grid), 0)\n      AS autonomy_pct,\n\n  100 * SUM(house_from_grid)\n      / NULLIF(SUM(house_from_pv + house_from_grid), 0)\n      AS grid_dependency_pct,\n\n  SUM(feed_in - house_from_grid) AS net_export\n\nFROM sun2000_monitoring_daily\nWHERE $__timeFilter(time)\nGROUP BY period\nORDER BY period;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ]
          }
        }
      ],
