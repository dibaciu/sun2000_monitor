          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  DATE_TRUNC('month', time) AS month,\n  SUM(battery_charge_kwh)    AS charge_kwh,\n  SUM(battery_discharge_kwh) AS discharge_kwh\nFROM sun2000_monitoring_daily\nWHERE\n$__timeFilter(time)\nGROUP BY month\nORDER BY month;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ]
          }
        }
      ],
      "title": "Monthly Battery Efficiency",
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "discharge_kwh"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "charge_kwh"
                }
              }
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "monthly_efficiency",
