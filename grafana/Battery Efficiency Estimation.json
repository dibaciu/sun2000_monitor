                "matcher": {
                  "id": "byName",
                  "options": "discharge_kwh / charge_kwh"
                }
              },
              "operator": "*",
              "right": {
                "fixed": "100"
              }
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
